/* Fensterino auf Cloudflare Workers: was gebaut und wie es ausgeliefert wird.
   - Die Website liegt in web/: statische Dateien, Kopfzeilen aus web/_headers, Fehlerseite web/404.html.
   - Nur /api/… läuft durch worker.js: die KI-Auswertung der Fotos aus functions/api/ki.js.
   - "name" muss genau so heißen wie der Worker im Cloudflare-Dashboard (Workers & Pages).
   Der Schlüssel ANTHROPIC_API_KEY gehört nur ins Dashboard (Einstellungen → Variablen und Geheimnisse, Typ Secret), nie hierher. */
{
  "name": "fenstero",
  "main": "worker.js",
  "compatibility_date": "2026-06-01",
  "assets": {
    "directory": "./web",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  // Variablen aus dem Dashboard (z. B. KI_MODELL_GENAU) bei jedem Deployment behalten
  "keep_vars": true,
  "observability": { "enabled": true }
}
